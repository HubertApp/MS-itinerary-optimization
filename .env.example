# Copier en .env et renseigner. Le .env n'est jamais versionne.

# Secrets
RABBITMQ_URL=amqp://<user>:<motdepasse>@rabbitmq:5672/
TOMTOM_API_KEY=

# Source de trafic : "synthetic" (par defaut, hors ligne) ou "tomtom"
TRAFFIC_SOURCE=synthetic

# Base de donnees. Hors conteneur, laisser les valeurs par defaut.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=optimization_db
